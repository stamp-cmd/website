{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "styrenewebv2",
    "compatibility_date": "2025-05-14",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "_site",
        "not_found_handling": "404-page"
    },
    "compatibility_flags": [
        "nodejs_compat"
    ],
}