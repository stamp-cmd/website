                    <span>
                        <li><a href="/">[ HOME ]</a></li>
                    </span>
                    <span>
                        <li><a href="/blogs">[ BLOGS ]</a></li>
                    </span>
                    <span>
                        <li><a href="/projects">[ PROJECTS ]</a></li>
                    </span>
                    <span>
                        <li><a href="/media">[ MEDIA ]</a></li>
                    </span>
                    <span>
                        <li><a href="/contact">[ CONTACT ]</a></li>
                    </span>
                    <span>
                        <li><a href="/random">[ /dev/random ]</a></li>
                    </span>
                </ul>
            </nav>
            {{ content }}
