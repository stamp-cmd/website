---
title: L7018 Map Tiler
layout: base.liquid
style: /css/app/tiler.css
code: /js/app/tiler.js
---

<main class="standard">
    <div class="block" id="box">
        <div>
            <section>
                <h1>L7018 Tile Solver</h1>
                <p>Graph traversal with <abbr title="Depth-First Search">DFS</abbr>, limit is 98x98.</p>
                <label for="width">Width</label>
                <input type="number" id="width" min="0" max="80">
                <label for="height">Height</label>
                <input type="number" id="height" min="0" max="80">
                <button id="generate">Generate Table</button>
                <button id="solve">Solve</button>
                <p id="time"></p>
            </section>
            <div style="height: 20px;"></div>
            <section>
                <table id="grid"></table>
            </section>
        </div>
    </div>
</main>